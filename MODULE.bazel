"""rules_vault — hermetic HashiCorp Vault for Bazel tests.

  Hermetic server (no cluster): vault_server, vault_server_health_check,
  vault_test, vault_policy — over a pinned, SHA-256-verified vault binary.

  Cluster install: vault_install (dev mode), vault_install_ha (HA Raft).
"""

module(
    name = "rules_vault",
    version = "0.4.0",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")

bazel_dep(name = "rules_kubectl", version = "0.2.0")
git_override(
    module_name = "rules_kubectl",
    remote = "https://github.com/collider-bazel-extensions/rules_kubectl",
    commit = "81b60ab80df46b64c612f2576ffef0a7af98ccb6",  # v0.2.0
)

# `vault_install_ha` (HA Raft mode, v0.2) emits an `sh_binary` for the
# custom apply+init+unseal+raft-join launcher, so rules_shell is part of
# the public surface (consumers transitively need it). `vault_install`
# (dev mode) only emits a kubectl_apply, no rules_shell needed for that
# code path.
bazel_dep(name = "rules_shell", version = "0.8.0")

# Public binary toolchain: the vault binary (server + CLI). Per-platform
# repos (vault_<ver>_<plat>) come from the `vault` extension, which only
# honours the root module's tags — consumers declare the same version.
vault = use_extension("//:extensions.bzl", "vault")
vault.version(version = "1.21.2")
use_repo(
    vault,
    "vault_1_21_2_darwin_amd64",
    "vault_1_21_2_darwin_arm64",
    "vault_1_21_2_linux_amd64",
    "vault_1_21_2_linux_arm64",
)
register_toolchains("@rules_vault//toolchain:all")

# ---- dev-only: smoke composition --------------------------------------------
bazel_dep(name = "rules_itest", version = "0.0.52", dev_dependency = True)

bazel_dep(name = "rules_kind", version = "0.3.0", dev_dependency = True)
git_override(
    module_name = "rules_kind",
    remote = "https://github.com/collider-bazel-extensions/rules_kind",
    commit = "12a73e02fe4b9400d3dc733a3d80ce06c47b6411",  # v0.3.0 — confirmed deletion + sweep, RULES_KIND_MAX_CLUSTERS
)

bazel_dep(name = "rules_helm", version = "0.2.1", dev_dependency = True)
git_override(
    module_name = "rules_helm",
    remote = "https://github.com/collider-bazel-extensions/rules_helm",
    commit = "48651387d55f0c50f6d059df246ed73767100afb",  # v0.2.1
)

helm = use_extension("@rules_helm//:extensions.bzl", "helm", dev_dependency = True)
helm.version(version = "3.20.2")
use_repo(
    helm,
    "helm_darwin_amd64",
    "helm_darwin_arm64",
    "helm_linux_amd64",
)
register_toolchains(
    "@helm_linux_amd64//:toolchain",
    "@helm_darwin_amd64//:toolchain",
    "@helm_darwin_arm64//:toolchain",
    dev_dependency = True,
)

vault_chart = use_extension("//tools:extensions.bzl", "vault_chart", dev_dependency = True)
vault_chart.version(version = "0.32.0")
use_repo(vault_chart, "vault_chart_0_32_0")
