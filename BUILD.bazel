load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//private:cli.bzl", "vault_cli")

package(default_visibility = ["//visibility:public"])

exports_files([
    "MODULE.bazel",
    "WORKSPACE",
    "defs.bzl",
    "extensions.bzl",
])

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    deps = [
        "//private:policy",
        "//private:providers",
        "//private:server",
        "//private:test",
        "@rules_kubectl//:defs",
    ],
)

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
    deps = ["//private:repositories"],
)

# `bazel run @rules_vault//:vault -- <args>`: the pinned vault CLI, run from
# the caller's directory.
vault_cli(name = "vault")
