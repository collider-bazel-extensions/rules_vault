load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(":toolchain.bzl", "current_vault_toolchain", "vault_toolchain")

package(default_visibility = ["//visibility:public"])

exports_files(["toolchain.bzl"])

toolchain_type(name = "vault")

# The resolved vault binary for the target platform, usable as `data`.
current_vault_toolchain(name = "current")

# Per-platform toolchains. Each `vault_<ver>_<plat>` repo (created by the
# module extension) ships the vault binary for one platform.

vault_toolchain(
    name      = "vault_linux_amd64_impl",
    version   = "1.21.2",
    vault_bin = "@vault_1_21_2_linux_amd64//:vault_bin",
)

toolchain(
    name                   = "vault_linux_amd64",
    toolchain_type         = ":vault",
    exec_compatible_with   = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    toolchain              = ":vault_linux_amd64_impl",
)

vault_toolchain(
    name      = "vault_linux_arm64_impl",
    version   = "1.21.2",
    vault_bin = "@vault_1_21_2_linux_arm64//:vault_bin",
)

toolchain(
    name                   = "vault_linux_arm64",
    toolchain_type         = ":vault",
    exec_compatible_with   = ["@platforms//os:linux", "@platforms//cpu:arm64"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:arm64"],
    toolchain              = ":vault_linux_arm64_impl",
)

vault_toolchain(
    name      = "vault_darwin_amd64_impl",
    version   = "1.21.2",
    vault_bin = "@vault_1_21_2_darwin_amd64//:vault_bin",
)

toolchain(
    name                   = "vault_darwin_amd64",
    toolchain_type         = ":vault",
    exec_compatible_with   = ["@platforms//os:osx", "@platforms//cpu:x86_64"],
    target_compatible_with = ["@platforms//os:osx", "@platforms//cpu:x86_64"],
    toolchain              = ":vault_darwin_amd64_impl",
)

vault_toolchain(
    name      = "vault_darwin_arm64_impl",
    version   = "1.21.2",
    vault_bin = "@vault_1_21_2_darwin_arm64//:vault_bin",
)

toolchain(
    name                   = "vault_darwin_arm64",
    toolchain_type         = ":vault",
    exec_compatible_with   = ["@platforms//os:osx", "@platforms//cpu:arm64"],
    target_compatible_with = ["@platforms//os:osx", "@platforms//cpu:arm64"],
    toolchain              = ":vault_darwin_arm64_impl",
)

bzl_library(
    name = "toolchain",
    srcs = ["toolchain.bzl"],
    deps = ["//private:providers"],
)
