"""Tests for rules_vault.

Hermetic server (no container runtime; `bazel test //tests/...`):
- example_test: issue #4's acceptance example — configure.sh, KV, PKI
  issue + CSR signing, worker / renewal policies, revoke by accessor.
- default_test, server_test, server_failure_test, health_check_test,
  policy_check_test, checksums_test, analysis tests.

Cluster (manual; needs Docker or podman):
- Analysis test verifies the macro instantiates cleanly.
- Smoke composition: kind cluster + Vault dev-mode StatefulSet.
  Smoke `kubectl run`s a curl pod, POSTs a KV v2 secret to
  /v1/secret/data/smoke, GETs it back, and asserts the value
  round-trips. Proves HTTP listener + token auth + KV v2 engine
  + in-memory backend r/w end-to-end.
"""

load("@rules_itest//:itest.bzl", "itest_service", "service_test")
load("@rules_kind//:defs.bzl", "kind_cluster", "kind_health_check")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(
    "@rules_vault//:defs.bzl",
    "vault_health_check",
    "vault_health_check_ha",
    "vault_install",
    "vault_install_ha",
    "vault_server",
    "vault_server_health_check",
    "vault_test",
)
load(":analysis_tests.bzl", "vault_install_test_suite", "vault_server_test_suite")

# ---- analysis ---------------------------------------------------------------

vault_install_test_suite(name = "vault_install_analysis")

vault_server_test_suite(name = "vault_server_analysis")

# ---- hermetic server --------------------------------------------------------

vault_test(
    name = "example_test",
    srcs = ["example_test.sh"],
    secrets_engines = {
        "pki": "pki",
        "pki_int": "pki",
    },
    policies = ["//tests/testdata:policies"],
    setup = ["//tests/testdata:configure"],
)

vault_test(
    name = "default_test",
    srcs = ["default_test.sh"],
    args = [
        "one",
        "'two words'",
    ],
    env = {"FROM_ENV_ATTR": "yes"},
)

vault_server(
    name = "test_server",
    audit = True,
    auth_methods = {"approle": "approle"},
    extra_args = ["-log-level=debug"],
    root_token = "test-token",
    secrets_engines = {"transit": "transit"},
    tags = ["manual"],
)

vault_server_health_check(
    name = "test_server_health",
    server = ":test_server",
    tags = ["manual"],
)

sh_test(
    name = "server_test",
    srcs = ["server_test.sh"],
    args = ["$(rootpath :test_server)"],
    data = [":test_server"],
)

sh_test(
    name = "health_check_test",
    srcs = ["health_check_test.sh"],
    args = ["$(rootpath :test_server_health)"],
    data = [":test_server_health"],
)

vault_server(
    name = "bad_flag_server",
    extra_args = ["-no-such-flag"],
    tags = ["manual"],
)

vault_server(
    name = "bad_setup_server",
    setup = ["//tests/testdata:fail_setup.sh"],
    tags = ["manual"],
)

vault_server(
    name = "slow_server",
    ready_timeout = "0.001",
    tags = ["manual"],
)

vault_test(
    name = "failing_vault_test",
    srcs = ["never_runs.sh"],
    setup = ["//tests/testdata:fail_setup.sh"],
    tags = ["manual"],
)

sh_test(
    name = "server_failure_test",
    srcs = ["server_failure_test.sh"],
    args = [
        "$(rootpath :bad_flag_server)",
        "$(rootpath :bad_setup_server)",
        "$(rootpath :slow_server)",
        # failing_vault_test's trampoline, run with the arguments its
        # sh_test would pass (a test target's args don't apply as data).
        "$(rootpath //private:vault_test_trampoline.sh)",
        "$(rootpath :failing_vault_test_vault)",
        "$(rootpath :failing_vault_test_inner)",
    ],
    data = [
        ":bad_flag_server",
        ":bad_setup_server",
        ":failing_vault_test_inner",
        ":failing_vault_test_vault",
        ":slow_server",
        "//private:vault_test_trampoline.sh",
    ],
)

vault_test(
    name = "record_port",
    srcs = ["record_port.sh"],
    tags = ["manual"],
)

sh_test(
    name = "server_cleanup_test",
    srcs = ["server_cleanup_test.sh"],
    args = [
        "$(rootpath //private:vault_test_trampoline.sh)",
        "$(rootpath :record_port_vault)",
        "$(rootpath :record_port_inner)",
    ],
    data = [
        ":record_port_inner",
        ":record_port_vault",
        "//private:vault_test_trampoline.sh",
    ],
)

# vault_server as a rules_itest service.
vault_server(
    name = "itest_server",
    secrets_engines = {"transit": "transit"},
    tags = ["manual"],
)

vault_server_health_check(
    name = "itest_server_health",
    server = ":itest_server",
    tags = ["manual"],
)

itest_service(
    name = "vault_hermetic_svc",
    exe = ":itest_server",
    health_check = ":itest_server_health",
    tags = ["manual"],
)

sh_test(
    name = "itest_test_bin",
    srcs = ["itest_test.sh"],
    tags = ["manual"],
)

service_test(
    name = "itest_test",
    services = [":vault_hermetic_svc"],
    test = ":itest_test_bin",
)

sh_test(
    name = "policy_check_test",
    srcs = ["policy_check_test.sh"],
    args = [
        "$(rootpath //private:check_policy)",
        "$(rootpath //toolchain:current)",
        "$(rootpath //tests/testdata:policies/worker.hcl)",
        "$(rootpath //tests/testdata:bad/bad_capability.hcl)",
        "$(rootpath //tests/testdata:bad/bad_syntax.hcl)",
        "$(rootpath //tests/testdata:bad/unformatted.hcl)",
    ],
    data = [
        "//private:check_policy",
        "//tests/testdata:bad/bad_capability.hcl",
        "//tests/testdata:bad/bad_syntax.hcl",
        "//tests/testdata:bad/unformatted.hcl",
        "//tests/testdata:policies/worker.hcl",
        "//toolchain:current",
    ],
)

sh_test(
    name = "checksums_test",
    srcs = ["checksums_test.sh"],
    data = ["//private:versions.bzl"],
)

# ---- cluster smoke compositions (manual) ------------------------------------

# ---- smoke composition ------------------------------------------------------

kind_cluster(name = "cluster", k8s_version = "1.35")

kind_health_check(name = "cluster_health", cluster = ":cluster")

itest_service(
    name = "kind_svc",
    exe = ":cluster",
    health_check = ":cluster_health",
    tags = ["manual"],
)

vault_install(
    name = "vault_install_bin",
    tags = ["manual"],
)

vault_health_check(
    name = "vault_health_bin",
    tags = ["manual"],
)

sh_binary(
    name = "vault_install_wrapper",
    srcs = ["install_wrapper.sh"],
    data = [":vault_install_bin"],
)

sh_binary(
    name = "vault_health_wrapper",
    srcs = ["health_wrapper.sh"],
    data = [":vault_health_bin"],
)

itest_service(
    name = "vault_svc",
    exe = ":vault_install_wrapper",
    deps = [":kind_svc"],
    health_check = ":vault_health_wrapper",
    tags = ["manual"],
)

sh_test(
    name = "smoke_test_bin",
    srcs = ["smoke_test.sh"],
    tags = ["manual"],
)

service_test(
    name = "smoke_test",
    services = [":vault_svc"],
    test = ":smoke_test_bin",
    tags = [
        "manual",
        "no-sandbox",
        "requires-network",
    ],
)

# ---- HA Raft smoke composition ---------------------------------------------
# Separate kind cluster (couldn't share with the dev-mode smoke if
# both run in parallel — different StatefulSet shapes share the
# `vault` namespace name). Apply HA manifest, init+unseal+raft-join
# via install_ha.sh, run KV v2 round-trip with leader + standby reads.

kind_cluster(name = "cluster_ha", k8s_version = "1.35")

kind_health_check(name = "cluster_ha_health", cluster = ":cluster_ha")

itest_service(
    name = "kind_ha_svc",
    exe = ":cluster_ha",
    health_check = ":cluster_ha_health",
    tags = ["manual"],
)

vault_install_ha(
    name = "vault_install_ha_bin",
    tags = ["manual"],
)

vault_health_check_ha(
    name = "vault_health_ha_bin",
    tags = ["manual"],
)

sh_binary(
    name = "vault_install_ha_wrapper",
    srcs = ["install_wrapper_ha.sh"],
    data = [":vault_install_ha_bin"],
)

sh_binary(
    name = "vault_health_ha_wrapper",
    srcs = ["health_wrapper_ha.sh"],
    data = [":vault_health_ha_bin"],
)

itest_service(
    name = "vault_ha_svc",
    exe = ":vault_install_ha_wrapper",
    deps = [":kind_ha_svc"],
    health_check = ":vault_health_ha_wrapper",
    tags = ["manual"],
)

sh_test(
    name = "smoke_test_ha_bin",
    srcs = ["smoke_test_ha.sh"],
    tags = ["manual"],
)

service_test(
    name = "smoke_test_ha",
    services = [":vault_ha_svc"],
    test = ":smoke_test_ha_bin",
    tags = [
        "manual",
        "no-sandbox",
        "requires-network",
    ],
)

# The wrapper stops on a missing runfile (vault binary, a setup script)
# instead of passing an empty path to the launcher.
sh_test(
    name = "wrapper_resolve_test",
    srcs = ["wrapper_resolve_test.sh"],
    args = [
        "$(rootpath :bad_setup_server)",
        "$(rootpath //private:launcher.py)",
        "$(rootpath //toolchain:current)",
        "$(rootpath //tests/testdata:fail_setup.sh)",
    ],
    data = [
        ":bad_setup_server",
        "//private:launcher.py",
        "//tests/testdata:fail_setup.sh",
        "//toolchain:current",
    ],
)
