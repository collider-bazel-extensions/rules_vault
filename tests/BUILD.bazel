"""Tests for rules_vault.

- Analysis test verifies the macro instantiates cleanly.
- Smoke composition: kind cluster + Vault dev-mode StatefulSet.
  Smoke `kubectl run`s a curl pod, POSTs a KV v2 secret to
  /v1/secret/data/smoke, GETs it back, and asserts the value
  round-trips. Proves HTTP listener + token auth + KV v2 engine
  + in-memory backend r/w end-to-end.
"""

load("@rules_itest//:itest.bzl", "itest_service", "service_test")
load("@rules_kind//:defs.bzl", "kind_cluster", "kind_health_check")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(
    "@rules_vault//:defs.bzl",
    "vault_health_check",
    "vault_health_check_ha",
    "vault_install",
    "vault_install_ha",
)
load(":analysis_tests.bzl", "vault_install_test_suite")

# ---- analysis ---------------------------------------------------------------

vault_install_test_suite(name = "vault_install_analysis")

# ---- smoke composition ------------------------------------------------------

kind_cluster(name = "cluster", k8s_version = "1.32")

kind_health_check(name = "cluster_health", cluster = ":cluster")

itest_service(
    name = "kind_svc",
    exe = ":cluster",
    health_check = ":cluster_health",
    tags = ["manual"],
)

vault_install(
    name = "vault_install_bin",
    tags = ["manual"],
)

vault_health_check(
    name = "vault_health_bin",
    tags = ["manual"],
)

sh_binary(
    name = "vault_install_wrapper",
    srcs = ["install_wrapper.sh"],
    data = [":vault_install_bin"],
)

sh_binary(
    name = "vault_health_wrapper",
    srcs = ["health_wrapper.sh"],
    data = [":vault_health_bin"],
)

itest_service(
    name = "vault_svc",
    exe = ":vault_install_wrapper",
    deps = [":kind_svc"],
    health_check = ":vault_health_wrapper",
    tags = ["manual"],
)

sh_test(
    name = "smoke_test_bin",
    srcs = ["smoke_test.sh"],
    tags = ["manual"],
)

service_test(
    name = "smoke_test",
    services = [":vault_svc"],
    test = ":smoke_test_bin",
    tags = [
        "manual",
        "no-sandbox",
        "requires-network",
    ],
)

# ---- HA Raft smoke composition ---------------------------------------------
# Separate kind cluster (couldn't share with the dev-mode smoke if
# both run in parallel — different StatefulSet shapes share the
# `vault` namespace name). Apply HA manifest, init+unseal+raft-join
# via install_ha.sh, run KV v2 round-trip with leader + standby reads.

kind_cluster(name = "cluster_ha", k8s_version = "1.32")

kind_health_check(name = "cluster_ha_health", cluster = ":cluster_ha")

itest_service(
    name = "kind_ha_svc",
    exe = ":cluster_ha",
    health_check = ":cluster_ha_health",
    tags = ["manual"],
)

vault_install_ha(
    name = "vault_install_ha_bin",
    tags = ["manual"],
)

vault_health_check_ha(
    name = "vault_health_ha_bin",
    tags = ["manual"],
)

sh_binary(
    name = "vault_install_ha_wrapper",
    srcs = ["install_wrapper_ha.sh"],
    data = [":vault_install_ha_bin"],
)

sh_binary(
    name = "vault_health_ha_wrapper",
    srcs = ["health_wrapper_ha.sh"],
    data = [":vault_health_ha_bin"],
)

itest_service(
    name = "vault_ha_svc",
    exe = ":vault_install_ha_wrapper",
    deps = [":kind_ha_svc"],
    health_check = ":vault_health_ha_wrapper",
    tags = ["manual"],
)

sh_test(
    name = "smoke_test_ha_bin",
    srcs = ["smoke_test_ha.sh"],
    tags = ["manual"],
)

service_test(
    name = "smoke_test_ha",
    services = [":vault_ha_svc"],
    test = ":smoke_test_ha_bin",
    tags = [
        "manual",
        "no-sandbox",
        "requires-network",
    ],
)
